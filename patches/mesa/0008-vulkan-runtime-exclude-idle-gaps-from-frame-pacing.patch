+static int
+compare_submit_intervals(const void *a, const void *b)
+{
+   const struct submit_interval *left = a;
+   const struct submit_interval *right = b;
+   return (left->begin > right->begin) - (left->begin < right->begin);
+}
+
+static uint64_t
+submit_intervals_duration(struct submit_interval *intervals, uint32_t count)
+{
+   if (!count)
+      return 0;
+
+   qsort(intervals, count, sizeof(*intervals), compare_submit_intervals);
+
+   uint64_t duration = 0;
+   uint64_t end = intervals[0].begin;
+   for (uint32_t i = 0; i < count; i++) {
+      const uint64_t begin = MAX2(end, intervals[i].begin);
+      if (intervals[i].end > begin)
+         duration += intervals[i].end - begin;
+      end = MAX2(end, intervals[i].end);
+   }
+   return duration;
+}
