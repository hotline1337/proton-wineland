    return radv_amdgpu_bo_va_op(ws, bo_handle, offset, size, addr, bo_flags, flags, ops);
 }
 
+static bool
+radv_amdgpu_has_va_batch(struct radv_amdgpu_winsys *ws)
+{
+   struct drm_amdgpu_info_gem_va_batch caps = {0};
+   return !ws->info.is_virtio &&
+          !ac_drm_query_info(ws->dev, AMDGPU_INFO_GEM_VA_BATCH, sizeof(caps), &caps) &&
+          caps.cookie == AMDGPU_GEM_VA_BATCH_COOKIE && caps.max_ops == AMDGPU_GEM_VA_BATCH_MAX_OPS &&
+          !caps.reserved;
+}
+
+static VkResult
+radv_amdgpu_winsys_bind_batch(struct radeon_winsys *_ws, const struct radv_sparse_bind_state *state)
+{
+   struct radv_amdgpu_winsys *ws = radv_amdgpu_winsys(_ws);
+
+   for (uint32_t i = 0; i < state->op_count;) {
+      struct drm_amdgpu_gem_va_batch batch = {
+         .cookie = AMDGPU_GEM_VA_BATCH_COOKIE,
+         .operations = (uintptr_t)(state->ops + i),
+         .count = MIN2(state->op_count - i, AMDGPU_GEM_VA_BATCH_MAX_OPS),
+      };
+      int r = drm_ioctl_write_read(ws->fd, DRM_AMDGPU_GEM_VA_BATCH, &batch, sizeof(batch));
+      if (r || batch.status || batch.applied != batch.count)
+         return VK_ERROR_DEVICE_LOST;
+      i += batch.count;
+   }
+   return VK_SUCCESS;
+}
