+static VkResult
+radv_sparse_image_bind_flush(struct radv_device *device, struct radv_image *image, VkSparseMemoryBind *pending)
+{
+   if (!pending->size)
+      return VK_SUCCESS;
+
+   VK_FROM_HANDLE(radv_device_memory, mem, pending->memory);
+   VkResult result = radv_bo_virtual_bind(device, &image->vk.base, image->bindings[0].bo, pending->resourceOffset,
+                                          pending->size, mem ? mem->bo : NULL, pending->memoryOffset);
+   if (result == VK_SUCCESS)
+      pending->size = 0;
+   return result;
+}
+
+static VkResult
+radv_sparse_image_bind_range(struct radv_device *device, struct radv_image *image, VkSparseMemoryBind *pending,
+                             const VkSparseMemoryBind *bind)
+{
+   if (pending->size && pending->memory == bind->memory && pending->flags == bind->flags &&
+       pending->resourceOffset + pending->size == bind->resourceOffset &&
+       (!bind->memory || pending->memoryOffset + pending->size == bind->memoryOffset)) {
+      pending->size += bind->size;
+      return VK_SUCCESS;
+   }
+
+   VkResult result = radv_sparse_image_bind_flush(device, image, pending);
+   if (result != VK_SUCCESS)
+      return result;
+
+   *pending = *bind;
+   return VK_SUCCESS;
+}
