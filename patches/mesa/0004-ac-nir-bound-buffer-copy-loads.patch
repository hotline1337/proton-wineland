 static nir_def *
+load_buffer_partial(nir_builder *b, const ac_cs_clear_copy_buffer_key *const key,
+                    unsigned num_components, unsigned bit_size, nir_def *buf, nir_def *offset,
+                    unsigned first_component, unsigned end_component, unsigned align_offset)
+{
+   nir_def *components[NIR_MAX_VEC_COMPONENTS];
+
+   assert(first_component < end_component && end_component <= num_components);
+   assert(nir_num_components_valid(num_components));
+
+   for (unsigned i = 0; i < num_components; i++)
+      components[i] = nir_undef(b, 1, bit_size);
+
+   for (unsigned i = first_component; i < end_component;) {
+      unsigned count = end_component - i;
+      while (!nir_num_components_valid(count))
+         count--;
+
+      const unsigned byte_offset = i * bit_size / 8;
+      nir_def *loaded = load_buffer_sparse(b, key, count, bit_size, buf,
+                                           nir_iadd_imm(b, offset, byte_offset), ACCESS_RESTRICT,
+                                           4, (align_offset + byte_offset) % 4,
+                                           key->src_scalarize_for_sparse);
+      for (unsigned j = 0; j < count; j++)
+         components[i + j] = nir_channel(b, loaded, j);
+      i += count;
+   }
+
+   return nir_vec(b, components, num_components);
+}
