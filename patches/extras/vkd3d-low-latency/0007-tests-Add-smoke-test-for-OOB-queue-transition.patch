diff --git a/tests/d3d12_dxvk_interop_device.c b/tests/d3d12_dxvk_interop_device.c
index 3afb1496..e83ddb38 100644
--- a/tests/d3d12_dxvk_interop_device.c
+++ b/tests/d3d12_dxvk_interop_device.c
