From b3e1cb71f138bc45636a9de092157f093d3e2977 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Tue, 29 Sep 2026 19:01:08 +0200
Subject: [PATCH 2/2] vkd3d: Retain ALLOW_UPDATE for final acceleration
 structure updates.

D3D12 permits the final update to omit ALLOW_UPDATE. Vulkan requires
update flags to match the source build, so retain the flag after input
conversion, before the build is submitted.

Test final BLAS and TLAS updates both in place and out of place,
with ray-query readback checks.
---
 libs/vkd3d/command.c     |   7 ++
 tests/d3d12_raytracing.c | 134 ++++++++++++++++++++++++++++++++++-----
 2 files changed, 124 insertions(+), 17 deletions(-)

diff --git a/libs/vkd3d/command.c b/libs/vkd3d/command.c
index 1273fb05..22c5df44 100644
--- a/libs/vkd3d/command.c
+++ b/libs/vkd3d/command.c
@@ -1,4 +1,6 @@
 /*
+ * Salkim modifications by Erhan Bilgili on 2026-09-30.
+ *
  * Copyright 2016 Józef Kucia for CodeWeavers
  * Copyright 2016 Henri Verbeet for CodeWeavers
  *
@@ -20598,6 +20600,11 @@ static void d3d12_command_list_build_raytracing_blas_and_tlas(struct d3d12_comma
         return;
     }
 
+    /* D3D12 allows clearing ALLOW_UPDATE on the final update, but Vulkan
+     * requires the update flags to match the source build. */
+    if (build_info->mode == VK_BUILD_ACCELERATION_STRUCTURE_MODE_UPDATE_KHR)
+        build_info->flags |= VK_BUILD_ACCELERATION_STRUCTURE_ALLOW_UPDATE_BIT_KHR;
+
     if (!vkd3d_acceleration_structure_resolve_omm_va_maps(list->device, &desc->Inputs,
             omm_triangles_infos))
         return;
