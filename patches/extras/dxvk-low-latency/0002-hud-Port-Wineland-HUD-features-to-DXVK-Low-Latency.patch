+  HudItemSet::HudItemSet(const Rc<DxvkDevice>& device)
+  : HudItemSet([&] {
+    std::string configStr = env::getEnvVar("DXVK_HUD");
+
+    if (configStr.empty())
+      configStr = device->config().hud;
+
+    return configStr;
+  }(), device->config().hudFpsLowsWindow) { }
