+
+  void HudItemSet::update() {
+    orderItems();
+
+    auto time = dxvk::high_resolution_clock::now();
+
+    if (m_fpsData)
+      m_fpsData->update(time);
+
+    for (const auto& item : m_items)
+      item->update(time);
+  }
