+        self.assertIn('CheckForUpdate=false', (self.destination / 'OptiScaler.ini').read_text())
+        self.assertIn('; Library location', (self.destination / 'OptiScaler.ini').read_text())
+
+    def test_ini_preserves_comments_case_spacing_bom_and_newlines(self):
+        for newline in (b'\n', b'\r\n'):
+            source = b'\xef\xbb\xbf' + newline.join((
+                b'; File header', b'[Libraries]', b'; Explanation',
+                b'  OptiDllPath : auto', b'Other=100% unchanged', b'',
+                b'[Other]', b'OptiDllPath=untouched', b'# Last comment',
+            ))
+            expected = source.replace(b'OptiDllPath : auto', b'OptiDllPath : C:\\umu')
+            result = nightly.update_ini(source, {('Libraries', 'optidllpath'): r'C:\umu'})
+            self.assertEqual(result, expected)
+            self.assertEqual(nightly.update_ini(result, {}), result)
+
+    def test_ini_adds_missing_options_and_sections(self):
+        source = b'[Libraries]\r\nExisting=kept\r\n[Other]\r\nValue=kept'
+        result = nightly.update_ini(source, {('Libraries', 'NewPath'): 'new',
+                                            ('Added', 'Enabled'): 'true'})
+        self.assertEqual(result, b'[Libraries]\r\nExisting=kept\r\nNewPath=new\r\n'
+                                b'[Other]\r\nValue=kept\r\n[Added]\r\nEnabled=true\r\n')
+
+    def test_ini_rejects_ambiguous_or_multiline_edits(self):
+        for source, changes in (
+            (b'[S]\nKey=a\nKEY=b\n', {('S', 'Key'): 'c'}),
+            (b'[S]\nKey=a\n  continuation\n', {('S', 'Key'): 'c'}),
+            (b'[S]\nKey=a\n', {('S', 'Key'): 'a\nInjected=true'}),
+        ):
+            with self.assertRaises((ValueError, nightly.configparser.Error)):
+                nightly.update_ini(source, changes)
+
+    def test_ini_preserves_unrelated_multiline_values(self):
+        source = b'[S]\nOther=text\n  Key=not an option\nKey=auto\n'
+        self.assertEqual(nightly.update_ini(source, {('S', 'Key'): 'new'}),
+                         source.replace(b'Key=auto', b'Key=new'))
+
+    def test_unknown_config_does_not_rewrite_ini(self):
+        self.installed()
+        original = (self.destination / 'OptiScaler.ini').read_bytes()
+        with mock.patch.object(nightly, 'resolve', return_value=self.item), \
+                mock.patch.object(nightly, 'atomic_write') as write:
+            self.assertTrue(self.setup(env={'PROTON_OPTISCALER_CONFIG':
+                                           'Missing.Option=true;malformed'}))
+        write.assert_not_called()
+        self.assertEqual((self.destination / 'OptiScaler.ini').read_bytes(), original)
 
     def test_empty_tracking_and_missing_ini_are_invalid(self):
         (self.compat / 'upscaler_files').write_text('{"opti_files": {}}')
