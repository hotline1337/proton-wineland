@@ -104,7 +105,51 @@ class OptiscalerTests(unittest.TestCase):
             self.assertTrue(self.setup(env={'PROTON_OPTISCALER_CONFIG': 'Hotfix.CheckForUpdate=false'}))
             self.assertTrue(self.setup(self.version))
             self.assertFalse(self.setup('nightly-20260905'))
