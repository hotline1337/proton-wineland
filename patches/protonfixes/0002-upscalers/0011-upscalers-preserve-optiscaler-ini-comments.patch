-    parser['Libraries']['NvngxFeaturePath'] = library_path
+    changes = {
+        ('Libraries', 'OptiDllPath'): library_path + r'\OptiScaler',
+        ('Libraries', 'NvngxDlssPath'): library_path,
+        ('Libraries', 'NvngxFeaturePath'): library_path,
+        ('Hotfix', 'CheckForUpdate'): 'false',
+        ('ProcessFilter', 'ProcessExclusionList'): '|'.join(EXCLUDED_PROCESSES),
