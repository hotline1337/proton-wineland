--- a/optiscaler_nightly.py
+++ b/optiscaler_nightly.py
@@ -161,6 +161,64 @@ def safe_name(name):
     return path
 
 
+def update_ini(data, changes):
+    """Change single-line options without reserializing the rest of the INI."""
+    text = data.decode('utf-8-sig')
+    parser = configparser.ConfigParser(interpolation=None)
+    parser.read_string(text)
+    pending = {(section, key.lower()): value for (section, key), value in changes.items()}
+    for (section, key), value in pending.items():
+        if '\n' in value or '\r' in value:
+            raise ValueError('INI overrides must be single-line values')
+        if parser.has_option(section, key) and '\n' in parser[section][key]:
+            raise ValueError(f'Cannot replace multiline option {section}.{key}')
+
+    newline = '\r\n' if '\r\n' in text else '\n'
+    output, section, option_indent = [], None, None
+
+    def append_options(current):
+        for name in tuple(pending):
+            if name[0] != current:
+                continue
+            if output and not output[-1].endswith(('\n', '\r')):
+                output.append(newline)
+            # Preserve the requested spelling for newly added options too.
+            key = next(key for sec, key in changes if (sec, key.lower()) == name)
+            output.append(f'{key}={pending.pop(name)}{newline}')
+
+    for line in text.splitlines(keepends=True):
+        stripped = line.lstrip()
+        if not stripped or stripped.startswith((';', '#', '\n', '\r')):
+            output.append(line)
+            continue
+        indent = len(line) - len(stripped)
+        if option_indent is not None and indent > option_indent:
+            output.append(line)
+            continue
+        header = parser.SECTCRE.match(stripped)
+        if header:
+            append_options(section)
+            section = header['header']
+            option_indent = None
+        else:
+            option = re.match(r'^(\s*([^:=]+?)\s*[:=][ \t]*)(.*?)(\r?\n)?$', line)
+            if option:
+                option_indent = indent
+            if option and (name := (section, option[2].strip().lower())) in pending:
+                line = option[1] + pending.pop(name) + (option[4] or '')
+        output.append(line)
+    append_options(section)
+    for section, _ in tuple(pending):
+        if not any(name[0] == section for name in pending):
+            continue
+        if output and not output[-1].endswith(('\n', '\r')):
+            output.append(newline)
+        output.append(f'[{section}]{newline}')
+        append_options(section)
+    bom = b'\xef\xbb\xbf' if data.startswith(b'\xef\xbb\xbf') else b''
+    return bom + ''.join(output).encode('utf-8')
+
+
