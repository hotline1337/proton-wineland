+        for item in [('xess', 'test-xess'), ('ffx3', 'test-ffx3'), ('ffx4', 'test-ffx4')]:
+            self.assertIn(item, calls)
+        self.assertEqual((self.destination / 'libxess.dll').read_bytes(), files['libxess.dll'])
+        self.assertTrue((self.destination / 'amd_fidelityfx_vk.dll').exists())
