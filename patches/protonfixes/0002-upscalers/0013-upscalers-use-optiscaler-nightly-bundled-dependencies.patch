+    def dependency_files(self, section, files):
+        tracking = self.compat / 'upscaler_files'
+        records = json.loads(tracking.read_text()) if tracking.exists() else {}
+        records.setdefault(section, {})
+        for name, data in files.items():
+            target = self.destination / name
+            target.parent.mkdir(parents=True, exist_ok=True)
+            target.write_bytes(data)
+            records[section][f'{nightly.ROOT}/{name}'] = {
+                'version': self.version, 'md5_hash': hashlib.md5(data).hexdigest(),
+            }
+        tracking.write_text(json.dumps(records))
+
+    def bundled_dependencies(self):
+        self.installed()
+        self.dependency_files('opti_files', {
+            'OptiScaler/libxess_dx11.dll': b'bundled dx11',
+            'OptiScaler/libxell.dll': b'bundled xell',
+            'OptiScaler/libxess_fg.dll': b'bundled xefg',
+            'OptiScaler/amd_fidelityfx_vk.dll': b'bundled vulkan',
+            'OptiScaler/amd_fidelityfx_loader_dx12.dll': b'bundled loader',
+            'OptiScaler/amd_fidelityfx_upscaler_dx12.dll': b'bundled upscaler',
+            'OptiScaler/amd_fidelityfx_framegeneration_dx12.dll': b'bundled fg',
+        })
+        ini = self.destination / 'OptiScaler.ini'
+        ini.write_bytes(nightly.update_ini(ini.read_bytes(), {
+            ('Libraries', 'OptiDllPath'): r'c:\windows\system32\umu\OptiScaler',
+        }))
