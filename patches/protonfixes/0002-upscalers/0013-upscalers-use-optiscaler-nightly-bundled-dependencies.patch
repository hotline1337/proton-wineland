+        files = {'libxess.dll': b'explicit xess'}
+        self.dependency_files('xess_files', files)
+        self.dependency_files('ffx3_files', {'amd_fidelityfx_vk.dll': b'explicit ffx'})
+        _, calls = self.run_upscalers({'xess', 'ffx3', 'ffx4'}, {
