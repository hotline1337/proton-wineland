+        with mock.patch.object(upscalers, 'setup_upscaler', return_value=True) as setup, \
+                mock.patch.object(upscalers, 'setup_optiscaler', return_value=optiscaler_enabled):
+            upscalers.setup_upscalers(set(config) | {'optiscaler'}, env, self.compat, self.prefix)
+        return env, [(call.args[0], call.args[3]) for call in setup.call_args_list]
