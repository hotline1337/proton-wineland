+        self.assertEqual(calls, [('dlss', 'default'), ('fsr4', 'default')])
+        self.assertEqual(env['WINE_OPTISCALER_NAME'], 'dxgi.dll')
+        self.assertNotIn('WINE_UPSCALER_REPLACE', env)
