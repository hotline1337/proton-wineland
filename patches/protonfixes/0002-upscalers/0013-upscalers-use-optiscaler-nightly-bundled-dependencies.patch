+        records['xess_files'][f'{nightly.ROOT}/libxess_fg.dll']['md5_hash'] = None
+        tracking.write_text(json.dumps(records))
+        before = self.snapshot()
+        self.run_upscalers()
+        self.assertEqual(self.snapshot(), before)
