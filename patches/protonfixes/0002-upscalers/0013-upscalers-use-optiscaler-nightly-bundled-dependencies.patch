+def __prune_optiscaler_dependencies(name, compat_dir, prefix_dir):
+    """Remove unchanged standalone files superseded by a validated nightly."""
+    dlls = {
+        'xess': ('libxess.dll', 'libxess_dx11.dll', 'libxell.dll', 'libxess_fg.dll'),
+        'ffx3': ('amd_fidelityfx_dx12.dll', 'amd_fidelityfx_vk.dll'),
+    }[name]
+    section = __xess_section if name == 'xess' else __ffx3_section
+    destination = Path(prefix_dir) / nightly.ROOT
+    try:
+        with open(Path(compat_dir) / '.optiscaler.lock', 'a') as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX)
+            package = __get_tracked_items(compat_dir, __opti_section)
+            if not nightly.is_nightly(next(iter(package.values()))['version']):
+                return
+            if (destination / 'OptiScaler').is_symlink():
+                return
+            tracked = __get_tracked_items(compat_dir, section)
+            parser = configparser.ConfigParser(interpolation=None)
+            parser.read(destination / 'OptiScaler.ini', encoding='utf-8-sig')
+            libraries = parser['Libraries']
+            # A custom search path may intentionally use the standalone files.
+            if ntpath.normcase(ntpath.normpath(libraries.get('OptiDllPath', 'auto'))) != \
+                    ntpath.normcase(r'c:\windows\system32\umu\OptiScaler'):
+                return
+            prefixes = ('xess', 'xefg', 'xell') if name == 'xess' else ('ffx',)
+            if any(key.startswith(prefixes) and value.strip().lower() not in ('', 'auto')
+                   for key, value in libraries.items()):
+                return
+
+            removed = []
+            remaining = dict(tracked)
+            for dll in dlls:
+                path = f'{nightly.ROOT}/{dll}'
+                checksum = tracked.get(path, {}).get('md5_hash')
+                target = destination / dll
+                if not checksum or target.is_symlink() or not target.is_file():
+                    continue
+                if nightly.file_hash(target, 'md5') != checksum.lower():
+                    continue
+                replacements = (dll,)
+                # Newer FidelityFX packages split the old combined DX12 library.
+                if dll == 'amd_fidelityfx_dx12.dll' and \
+                        f'{nightly.ROOT}/OptiScaler/{dll}' not in package:
+                    replacements = ('amd_fidelityfx_loader_dx12.dll',
+                                    'amd_fidelityfx_upscaler_dx12.dll',
+                                    'amd_fidelityfx_framegeneration_dx12.dll')
+                for replacement in replacements:
+                    bundled = f'{nightly.ROOT}/OptiScaler/{replacement}'
+                    expected = package.get(bundled, {}).get('md5_hash')
+                    file = Path(prefix_dir) / bundled
+                    if (not expected or file.is_symlink() or not file.is_file()
+                            or nightly.file_hash(file, 'md5') != expected.lower()):
+                        break
+                else:
+                    removed.append(dll)
+                    del remaining[path]
+            if removed:
+                # Delete-only transaction: no files are read from the staging path.
+                nightly.install(destination, destination, removed, (),
+                                lambda: __set_tracked_items(compat_dir, section, remaining))
+                log.info(f'Removed redundant OptiScaler dependencies: {", ".join(removed)}')
+    except (KeyError, StopIteration, FileNotFoundError):
+        return
+    except Exception as error:
+        log.warn(f'Keeping standalone {name.upper()} files: {error}')
+
