+        self.dependency_files('ffx3_files', {'amd_fidelityfx_vk.dll': b'old vk',
+                                           'amd_fidelityfx_dx12.dll': b'old combined'})
+        # Extra names in a tracker are not permission to delete arbitrary files.
+        self.dependency_files('xess_files', {'unrelated.dll': b'keep'})
+        before_ini = (self.destination / 'OptiScaler.ini').read_bytes()
+        self.run_upscalers()
+        for name in ('libxess.dll', 'libxell.dll', 'amd_fidelityfx_vk.dll', 'amd_fidelityfx_dx12.dll'):
+            self.assertFalse((self.destination / name).exists())
+        records = json.loads((self.compat / 'upscaler_files').read_text())
+        self.assertEqual(set(records['xess_files']), {f'{nightly.ROOT}/unrelated.dll'})
+        self.assertEqual(records['ffx3_files'], {})
+        self.assertTrue(upscalers.check_optiscaler(self.compat, self.prefix, ignore_version=True))
+        self.assertEqual((self.destination / 'OptiScaler.ini').read_bytes(), before_ini)
+        self.run_upscalers()  # Migration is idempotent.
+        self.assertEqual(json.loads((self.compat / 'upscaler_files').read_text()), records)
