+        (self.destination / 'libxess_dx11.dll').write_bytes(b'untracked')
+        (self.destination / 'libxell.dll').unlink()
+        (self.destination / 'libxell.dll').symlink_to('OptiScaler/libxell.dll')
+        tracking = self.compat / 'upscaler_files'
