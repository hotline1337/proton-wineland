diff --git a/optiscaler_streamline.py b/optiscaler_streamline.py
new file mode 100644
index 0000000..602260e
--- /dev/null
+++ b/optiscaler_streamline.py
@@ -0,0 +1,143 @@
+"""Optional Streamline runtime for OptiScaler nightlies; no game files are replaced."""
+
+import json
+import os
+import re
+import shutil
+import stat
+import tempfile
+import urllib.request
+import zipfile
+from pathlib import Path
+
+from . import optiscaler_nightly as nightly
+from .logger import log
+
+
+REPOSITORY = 'NVIDIA-RTX/Streamline'
+ROOT = 'OptiScaler/streamline'
+REQUIRED = ('sl.interposer.dll', 'sl.common.dll', 'sl.dlss_g.dll', 'sl.reflex.dll', 'sl.pcl.dll')
+DLSS = ('nvngx_dlss.dll', 'nvngx_dlssd.dll', 'nvngx_dlssg.dll')
+
+
+def release_item(release):
+    tag = release['tag_name']
+    if not re.fullmatch(r'v\d+\.\d+\.\d+', tag) or release.get('draft') or release.get('prerelease'):
+        raise ValueError('Expected a stable Streamline SDK release')
+    # Windows x64 even on an ARM host running x64 games; exclude ARM native SDKs.
+    name = f'streamline-sdk-{tag}.zip'
+    assets = [asset for asset in release['assets'] if asset['name'] == name]
+    if len(assets) != 1:
+        raise ValueError('Expected one Windows x64 Streamline SDK asset')
+    asset = assets[0]
+    digest = asset.get('digest') or ''
+    url = f'https://github.com/{REPOSITORY}/releases/download/{tag}/{name}'
+    if not re.fullmatch(r'sha256:[0-9a-f]{64}', digest) or asset['browser_download_url'] != url:
+        raise ValueError('Unverified Streamline SDK asset')
+    return {'version': tag, 'download_url': url, 'sha256': digest[7:]}
+
+
+def resolve(cache):
+    metadata = Path(cache) / 'streamline' / 'latest.json'
+    request = urllib.request.Request(f'https://api.github.com/repos/{REPOSITORY}/releases/latest',
+                                     headers={'User-Agent': 'Proton-OptiScaler'})
+    try:
+        with urllib.request.urlopen(request, timeout=10) as response:
+            release = json.load(response)
+        item = release_item(release)
+    except Exception as error:
+        log.warn(f'Cannot resolve Streamline: {error}')
+        return release_item(json.loads(metadata.read_text(encoding='utf-8')))
+    nightly.atomic_write(metadata, json.dumps(release).encode('utf-8'))
+    return item
+
+
+def prepare(item, cache, stage, destination):
+    if not (Path(destination) / 'nvngx_dlssg.dll').is_file():
+        raise ValueError('Streamline requires the managed nvngx_dlssg.dll')
+    archive = nightly.verified_download(item['download_url'],
+                                       Path(cache) / 'streamline' / (item['sha256'] + '.zip'),
+                                       item['sha256'])
+    files = {}
+    with zipfile.ZipFile(archive) as source:
+        # Some SDK archives wrap their contents in one versioned directory.
+        roots = {entry.filename[:-len('bin/x64/sl.interposer.dll')]
+                 for entry in source.infolist()
+                 if entry.filename.endswith('bin/x64/sl.interposer.dll')}
+        if len(roots) != 1:
+            raise ValueError('Ambiguous Streamline SDK layout')
+        root = roots.pop()
+        if root and not root.endswith('/'):
+            raise ValueError('Invalid Streamline SDK root')
+        for entry in source.infolist():
+            path = nightly.safe_name(entry.filename.rstrip('/'))
+            if entry.is_dir() or not entry.filename.startswith(root):
+                continue
+            name = entry.filename[len(root):]
+            runtime = name.startswith('bin/x64/') and '/' not in name[len('bin/x64/'):]
+            if runtime and path.suffix.lower() == '.dll':
+                if path.name.lower().startswith('nvngx_dlss'):
+                    continue
+                relative = f'{ROOT}/{path.name.lower()}'
+            elif '/' not in name and ('license' in name.lower() or 'notice' in name.lower()):
+                relative = f'{ROOT}/Licenses/{name}'
+            else:
+                continue
+            kind = stat.S_IFMT(entry.external_attr >> 16)
+            if kind not in (0, stat.S_IFREG) or relative in files:
+                raise ValueError(f'Unexpected Streamline SDK member: {entry.filename}')
+            target = Path(stage) / relative
+            target.parent.mkdir(parents=True, exist_ok=True)
+            with source.open(entry) as data, target.open('wb') as output:
+                shutil.copyfileobj(data, output)
+            files[relative] = {'sha256': nightly.file_hash(target)}
+    if any(f'{ROOT}/{name}' not in files for name in REQUIRED):
+        raise ValueError('Incomplete Streamline runtime')
+    if not any(name.startswith(f'{ROOT}/Licenses/') for name in files):
+        raise ValueError('Streamline SDK contains no licence notices')
+    for name in DLSS:
+        if (Path(destination) / name).is_file():
+            relative = f'{ROOT}/{name}'
+            link = '../../' + name
+            (Path(stage) / relative).symlink_to(link)
+            files[relative] = {'symlink': link}
+    return {name: {**record, 'version': item['version'], 'archive_sha256': item['sha256']}
+            for name, record in files.items()}
+
+
+def current(item, destination, records):
+    if any(f'{ROOT}/{name}' not in records for name in REQUIRED + ('nvngx_dlssg.dll',)):
+        return False
+    for name in DLSS:
+        if (Path(destination) / name).is_file() != (f'{ROOT}/{name}' in records):
+            return False
+    for name, record in records.items():
+        path = Path(destination) / name
+        if (record['version'] != item['version'] or record['archive_sha256'] != item['sha256']
+                or not path.is_file()):
+            return False
+        if 'symlink' in record:
+            if not path.is_symlink() or os.readlink(path) != record['symlink']:
+                return False
+        elif path.is_symlink() or nightly.file_hash(path) != record['sha256']:
+            return False
+    return True
+
+
+def setup(cache, destination, records, commit):
+    """The caller holds the prefix setup lock. Fail without disabling OptiScaler."""
+    try:
+        for name in records:
+            nightly.safe_name(name)
+            if not name.startswith(ROOT + '/'):
+                raise ValueError('Invalid Streamline tracking path')
+        item = resolve(cache)
+        if current(item, destination, records):
+            return
+        log.info(f'Updating OptiScaler Streamline runtime to {item["version"]}')
+        with tempfile.TemporaryDirectory(prefix='.streamline-stage-', dir=Path(destination).parent) as tmp:
+            stage = Path(tmp)
+            files = prepare(item, cache, stage, destination)
+            nightly.install(stage, destination, records, files, lambda: commit(files))
+    except Exception as error:
+        log.warn(f'Cannot update Streamline; keeping the previous installation: {error}')
