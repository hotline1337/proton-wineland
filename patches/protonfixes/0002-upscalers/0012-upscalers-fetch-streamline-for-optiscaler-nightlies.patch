         with mock.patch.object(nightly, 'resolve', return_value=self.item) as resolve, \
diff --git a/tests/test_optiscaler_streamline.py b/tests/test_optiscaler_streamline.py
new file mode 100644
index 0000000..7dd9fc8
--- /dev/null
+++ b/tests/test_optiscaler_streamline.py
@@ -0,0 +1,233 @@
+"""Isolated Streamline tests: run directly with Python, without Wine or network."""
+
+import hashlib
+import io
+import json
+import os
+import stat
+import tempfile
+import unittest
+import zipfile
+from pathlib import Path
+from unittest import mock
+
+from test_optiscaler import nightly, upscalers
+
+
+streamline = upscalers.streamline
+
+
+def release(digest='a' * 64, tag='v2.14.1'):
+    name = f'streamline-sdk-{tag}.zip'
+    return {'tag_name': tag, 'assets': [{
+        'name': name, 'digest': 'sha256:' + digest,
+        'browser_download_url': f'https://github.com/{streamline.REPOSITORY}/releases/download/{tag}/{name}',
+    }]}
+
+
+class StreamlineTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.root = Path(temporary.name)
+        self.cache = self.root / 'cache'
+        self.destination = self.root / 'umu'
+        self.destination.mkdir()
+        for name in streamline.DLSS:
+            (self.destination / name).write_bytes(b'managed ' + name.encode())
+        self.records = {}
+        self.item = streamline.release_item(release())
+
+    def archive(self, *, prefix='', omit=(), extra=()):
+        data = io.BytesIO()
+        with zipfile.ZipFile(data, 'w') as output:
+            for name in streamline.REQUIRED + ('sl.dlss.dll',) + streamline.DLSS:
+                if name not in omit:
+                    output.writestr(prefix + 'bin/x64/' + name, b'SDK ' + name.encode())
+            output.writestr(prefix + 'bin/x64/development/sl.common.dll', b'never install debug')
+            output.writestr(prefix + 'bin/x64/README.txt', b'not runtime')
+            output.writestr(prefix + 'bin/x64/sl.interposer.lib', b'not runtime')
+            output.writestr(prefix + 'bin/aarch64/sl.common.dll', b'wrong architecture')
+            output.writestr(prefix + 'license.txt', b'SDK license')
+            output.writestr(prefix + '3rd-party-licenses.md', b'third party notices')
+            for name, payload in extra:
+                output.writestr(name, payload)
+        archive = self.root / 'sdk.zip'
+        archive.write_bytes(data.getvalue())
+        self.item = streamline.release_item(release(hashlib.sha256(data.getvalue()).hexdigest()))
+        return archive
+
+    def commit(self, records):
+        self.records = records
+
+    def setup(self, archive):
+        with mock.patch.object(streamline, 'resolve', return_value=self.item), \
+                mock.patch.object(nightly, 'verified_download', return_value=archive):
+            streamline.setup(self.cache, self.destination, self.records, self.commit)
+
+    def snapshot(self):
+        return {str(path.relative_to(self.destination)):
+                os.readlink(path) if path.is_symlink() else path.read_bytes()
+                for path in self.destination.rglob('*') if path.is_file() or path.is_symlink()}
+
+    def test_production_only_layout_links_and_licences(self):
+        for prefix in ('', 'streamline-sdk-v2.14.1/'):
+            with self.subTest(prefix=prefix):
+                self.setup(self.archive(prefix=prefix))
+                self.assertTrue(streamline.current(self.item, self.destination, self.records))
+                for name in streamline.DLSS:
+                    dll = self.destination / streamline.ROOT / name
+                    self.assertEqual(os.readlink(dll), '../../' + name)
+                    self.assertEqual(dll.read_bytes(), b'managed ' + name.encode())
+                self.assertEqual(len(self.records), 6 + 3 + 2)
+                self.assertEqual((self.destination / streamline.ROOT / 'Licenses/license.txt').read_bytes(),
+                                 b'SDK license')
+                self.assertFalse((self.destination / streamline.ROOT / 'development').exists())
+
+    def test_current_install_needs_no_download(self):
+        self.setup(self.archive())
+        with mock.patch.object(streamline, 'resolve', return_value=self.item), \
+                mock.patch.object(nightly, 'verified_download') as download:
+            streamline.setup(self.cache, self.destination, self.records, self.commit)
+        download.assert_not_called()
+
+    def test_managed_dlss_upgrade_uses_existing_links(self):
+        self.setup(self.archive())
+        (self.destination / 'nvngx_dlssg.dll').write_bytes(b'new managed version')
+        self.assertTrue(streamline.current(self.item, self.destination, self.records))
+        self.assertEqual((self.destination / streamline.ROOT / 'nvngx_dlssg.dll').read_bytes(),
+                         b'new managed version')
+
+    def test_corrupt_runtime_or_link_is_repaired(self):
+        archive = self.archive()
+        self.setup(archive)
+        target = self.destination / streamline.ROOT / 'sl.common.dll'
+        target.write_bytes(b'corrupt')
+        link = self.destination / streamline.ROOT / 'nvngx_dlssg.dll'
+        link.unlink()
+        link.symlink_to('../../nvngx_dlss.dll')
+        self.assertFalse(streamline.current(self.item, self.destination, self.records))
+        self.setup(archive)
+        self.assertTrue(streamline.current(self.item, self.destination, self.records))
+
+    def test_failed_download_keeps_installed_runtime(self):
+        self.setup(self.archive())
+        before = self.snapshot()
+        with mock.patch.object(streamline, 'resolve', return_value={**self.item, 'version': 'v2.15.0'}), \
+                mock.patch.object(nightly, 'verified_download', side_effect=OSError('offline')):
+            streamline.setup(self.cache, self.destination, self.records, self.commit)
+        self.assertEqual(before, self.snapshot())
+
+    def test_failed_commit_rolls_back_runtime_and_links(self):
+        archive = self.archive()
+        self.setup(archive)
+        before, records = self.snapshot(), self.records.copy()
+        archive = self.archive(extra=[('bin/x64/sl.new.dll', b'new')])
+        with mock.patch.object(streamline, 'resolve', return_value=self.item), \
+                mock.patch.object(nightly, 'verified_download', return_value=archive):
+            streamline.setup(self.cache, self.destination, self.records,
+                             mock.Mock(side_effect=OSError('disk full')))
+        self.assertEqual(before, self.snapshot())
+        self.assertEqual(records, self.records)
+
+    def test_failed_file_replace_rolls_back_runtime(self):
+        self.setup(self.archive())
+        before = self.snapshot()
+        archive = self.archive(extra=[('bin/x64/sl.new.dll', b'new')])
+        replace = os.replace
+
+        def fail(source, target):
+            if '.streamline-stage-' in str(source) and Path(target).name == 'sl.common.dll':
+                raise OSError('injected rename failure')
+            return replace(source, target)
+
+        with mock.patch.object(os, 'replace', side_effect=fail):
+            self.setup(archive)
+        self.assertEqual(before, self.snapshot())
+
+    def test_runtime_update_removes_only_old_owned_files(self):
+        self.setup(self.archive(extra=[('bin/x64/sl.old.dll', b'old')]))
+        custom = self.destination / streamline.ROOT / 'user.dll'
+        custom.write_bytes(b'custom')
+        self.setup(self.archive())
+        self.assertFalse((self.destination / streamline.ROOT / 'sl.old.dll').exists())
+        self.assertEqual(custom.read_bytes(), b'custom')
+
+    def test_untracked_conflict_or_parent_link_is_not_overwritten(self):
+        folder = self.destination / streamline.ROOT
+        folder.mkdir(parents=True)
+        (folder / 'sl.common.dll').write_bytes(b'user override')
+        before = self.snapshot()
+        self.setup(self.archive())
+        self.assertEqual(before, self.snapshot())
+        self.assertFalse(self.records)
+        (folder / 'sl.common.dll').unlink()
+        folder.rmdir()
+        outside = self.root / 'outside'
+        outside.mkdir()
+        folder.symlink_to(outside)
+        self.setup(self.archive())
+        self.assertEqual(list(outside.iterdir()), [])
+        self.assertFalse(self.records)
+
+    def test_incomplete_archive_or_missing_fg_keeps_existing_install(self):
+        self.setup(self.archive())
+        before = self.snapshot()
+        self.setup(self.archive(omit=('sl.common.dll',)))
+        self.assertEqual(before, self.snapshot())
+        (self.destination / 'nvngx_dlssg.dll').unlink()
+        before = self.snapshot()
+        self.setup(self.archive(extra=[('bin/x64/sl.new.dll', b'new')]))
+        self.assertEqual(before, self.snapshot())
+
+    def test_traversal_links_duplicates_and_ambiguous_layout_are_rejected(self):
+        link = zipfile.ZipInfo('bin/x64/sl.bad.dll')
+        link.create_system = 3
+        link.external_attr = (stat.S_IFLNK | 0o777) << 16
+        for extra in (
+            [('../escape', b'bad')],
+            [(r'bin\x64\sl.bad.dll', b'bad')],
+            [(link, b'/outside')],
+            [('bin/x64/SL.COMMON.DLL', b'case collision')],
+            [('other/bin/x64/sl.interposer.dll', b'ambiguous')],
+        ):
+            with self.subTest(extra=extra):
+                self.setup(self.archive(extra=extra))
+                self.assertFalse(self.records)
+                self.assertEqual(sorted(path.name for path in self.destination.iterdir()),
+                                 sorted(streamline.DLSS))
+
+    def test_tracking_cannot_target_another_package(self):
+        before = self.snapshot()
+        self.records = {'nvngx_dlss.dll': {}}
+        self.setup(self.archive())
+        self.assertEqual(before, self.snapshot())
+
+    def test_offline_resolution_uses_verified_cached_metadata(self):
+        with mock.patch.object(streamline.urllib.request, 'urlopen',
+                               return_value=io.BytesIO(json.dumps(release()).encode())):
+            expected = streamline.resolve(self.cache)
+        with mock.patch.object(streamline.urllib.request, 'urlopen', side_effect=OSError('offline')):
+            self.assertEqual(streamline.resolve(self.cache), expected)
+            with self.assertRaises(FileNotFoundError):
+                streamline.resolve(self.root / 'empty')
+
+    def test_wrong_release_architecture_url_and_digest_are_rejected(self):
+        for change in ('prerelease', 'draft', 'architecture', 'url', 'digest', 'duplicate'):
+            data = release()
+            if change in ('prerelease', 'draft'):
+                data[change] = True
+            elif change == 'architecture':
+                data['assets'][0]['name'] = 'streamline-sdk-v2.14.1-arm64ec.zip'
+            elif change == 'url':
+                data['assets'][0]['browser_download_url'] = 'https://example.com/sdk.zip'
+            elif change == 'digest':
+                data['assets'][0]['digest'] = None
+            else:
+                data['assets'].append(data['assets'][0])
+            with self.subTest(change=change), self.assertRaises(ValueError):
+                streamline.release_item(data)
+
+
+if __name__ == '__main__':
+    unittest.main()
