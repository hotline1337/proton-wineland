+        with mock.patch.object(nightly, 'resolve', side_effect=OSError('offline')):
+            self.assertTrue(self.setup('nightly'))
+        self.assertEqual(self.streamline_setup.call_count, 2)
+
+    def test_failed_streamline_bootstrap_does_not_disable_optiscaler(self):
+        self.streamline_setup.side_effect = streamline_setup
