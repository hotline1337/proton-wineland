 tests/test_optiscaler_streamline.py | 143 ++++++++++++++++++++-
 upscalers.py                        |  12 +-
 5 files changed, 267 insertions(+), 23 deletions(-)

diff --git a/optiscaler_nightly.py b/optiscaler_nightly.py
index 75dd567..8453e81 100644
--- a/optiscaler_nightly.py
+++ b/optiscaler_nightly.py
@@ -305,6 +305,28 @@ def prepare_stable(archive, hashes, stage):
     return files
 
 
+def prune_symlinks(destination, records, links, commit):
+    """Retire known installer aliases, preserving files or links users replaced."""
+    destination = Path(destination)
+    remaining = dict(records)
+    removed = []
+    for name, link in links.items():
+        record = records.get(name, {})
+        # Main-package aliases used a null checksum. Streamline records the link.
+        if not (record.get('symlink') == link or
+                ('md5_hash' in record and record['md5_hash'] is None
+                 and is_nightly(record.get('version', '')))):
+            continue
+        target = destination / name
+        if target.is_symlink() and os.readlink(target) == link:
+            removed.append(name)
+        # Stop owning user replacements as well, so a later update preserves them.
+        del remaining[name]
+    if remaining != records:
+        install(destination, destination, removed, (), lambda: commit(remaining))
+    return remaining
+
+
 def install(stage, destination, old_names, new_names, commit):
     """Replace owned files with rollback on failure, including metadata failure."""
     stage, destination = Path(stage), Path(destination)
